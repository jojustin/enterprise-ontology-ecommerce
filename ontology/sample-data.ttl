@prefix ns1: <http://example.com/ecommerce/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ns1:Customer101 a ns1:Customer,
        owl:NamedIndividual ;
    rdfs:label "Customer101" ;
    ns1:customerEmail "john@example.com"^^xsd:string ;
    ns1:customerName "customerEmail"^^xsd:string ;
    ns1:placesOrder ns1:Order101 .

ns1:Order101 a ns1:Order,
        owl:NamedIndividual ;
    rdfs:label "Order101" ;
    ns1:containsProduct ns1:Product101 ;
    ns1:hasPayment ns1:Payment101 ;
    ns1:orderStatus "Confirmed"^^xsd:string .

ns1:Payment101 a ns1:Payment,
        owl:NamedIndividual ;
    rdfs:label "Payment101" ;
    ns1:paymentAmount 75000.00 ;
    ns1:paymentStatus "Completed"^^xsd:string .

ns1:Product101 a ns1:Product,
        owl:NamedIndividual ;
    rdfs:label "Product101" ;
    ns1:productName "Laptop"^^xsd:string ;
    ns1:productPrice 75000.00 .

